{
  "name": "folkbench-switch",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Folkbench desktop assistant for API services the user already bought",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Folkbench/folkbench.git"
  },
  "homepage": "https://github.com/Folkbench/Folkbench-switch#readme",
  "bugs": {
    "url": "https://github.com/Folkbench/folkbench/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "guard:host": "node scripts/assert-development-host.mjs",
    "preinstall": "node scripts/assert-development-host.mjs",
    "dev:web": "bun run guard:host && vite",
    "build:web": "bun run guard:host && bun run version:check && tsc -b && vite build",
    "typecheck": "bun run guard:host && tsc -b",
    "format": "bun run guard:host && prettier --write .",
    "format:check": "bun run guard:host && prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "test:release-tools": "node --test scripts/*.test.mjs",
    "check": "bun run version:check && bun run test:release-tools && bun run i18n:check && bun run typecheck",
    "icon:placeholder": "node scripts/generate-placeholder-icon.mjs",
    "icon:rgba": "node scripts/ensure-png-rgba.mjs",
    "bridge:generate": "bun run guard:host && cd src-tauri && TS_RS_EXPORT_DIR=../../../src/bridge/generated cargo test -p folkbench-switch-contract --features generate-bindings",
    "rust:test": "bun run guard:host && cd src-tauri && cargo test --workspace",
    "rust:fmt": "bun run guard:host && cd src-tauri && cargo fmt --all",
    "rust:fmt:check": "bun run guard:host && cd src-tauri && cargo fmt --all --check",
    "tauri": "bun run guard:host && tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "i18next": "26.4.1",
    "motion": "14.0.0",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "shadcn": "4.19.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
