---
import SourceList from './SourceList.astro'
import { getPersona } from '../data/authors'
import type { ArticleEntry } from '../lib/content'
import { localeLabel, localePath, type BlogLocale } from '../lib/site'

type Props = {
  entry: ArticleEntry
  locale: BlogLocale
  translations?: ArticleEntry[]
}

const { entry, locale, translations = [] } = Astro.props
const persona = getPersona(entry.data.authorId)
const copy = {
  'zh-CN': { reader: '用户投稿', views: '非本站观点', updated: '更新于' },
  en: { reader: 'Reader submission', views: "The contributor's own views", updated: 'Updated' },
  es: { reader: 'Aportación de lectores', views: 'Opiniones de quien escribe', updated: 'Actualizado' },
}[locale]
---
<main>
  <article>
    <header class="article-head article-shell">
      <p class="article-kind">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="article-meta">
        {entry.data.contributor ? (
          <>
            <span class="article-persona"><strong>{entry.data.contributor}</strong></span>
            <span>{copy.reader}</span>
            <span>{copy.views}</span>
          </>
        ) : (
          <>
            <span class="article-persona"><span class="article-persona-avatar">{persona.initials}</span><strong>{persona.name}</strong></span>
            <span>{persona.role[locale]}</span>
          </>
        )}
        <time datetime={entry.data.updatedAt}>{copy.updated} {entry.data.updatedAt}</time>
        {translations.map((translation) => (
          <a href={localePath(translation.data.locale, `/blog/${translation.data.slug}`)} key={translation.data.locale}>{localeLabel(translation.data.locale)} →</a>
        ))}
      </div>
      <figure class="article-cover">
        <img src={`/covers/${entry.data.translationKey}.webp`} alt="" loading="eager" decoding="async" />
      </figure>
    </header>
    <div class="article-body article-shell">
      <slot />
      <SourceList sources={entry.data.sources} locale={locale} />
    </div>
  </article>
</main>
