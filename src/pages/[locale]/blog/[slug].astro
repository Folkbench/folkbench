---
import { render } from 'astro:content'
import ArticleDetail from '../../../components/ArticleDetail.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getArticles, getTranslations } from '../../../lib/content'
import { articleJsonLd } from '../../../lib/seo'
import { PREFIXED_LOCALES, absoluteUrl } from '../../../lib/site'

export async function getStaticPaths() {
  const groups = await Promise.all(PREFIXED_LOCALES.map(async (locale) => (await getArticles(locale))
    .map((entry) => ({ params: { locale, slug: entry.data.slug }, props: { entry, locale } }))))
  return groups.flat()
}

const { entry, locale } = Astro.props
const translations = await getTranslations(entry)
const { Content } = await render(entry)
const jsonLd = articleJsonLd(entry, locale)
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  pathname={`/blog/${entry.data.slug}`}
  type="article"
  jsonLd={jsonLd}
  publishedAt={`${entry.data.publishedAt}T00:00:00Z`}
  updatedAt={`${entry.data.updatedAt}T00:00:00Z`}
  author="Folkbench Editorial Desk"
  image={absoluteUrl(`/covers/${entry.data.translationKey}.webp`)}
>
  <ArticleDetail entry={entry} locale={locale} translations={translations}>
    <Content />
  </ArticleDetail>
</BaseLayout>
